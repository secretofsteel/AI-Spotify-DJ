{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src", "vite-env.d.ts"]
}
